{
  "name": "carpool-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:foundation": "node --test tests/foundation.test.mjs tests/auth-flow.test.mjs tests/household-setup.test.mjs tests/weekly-checkin.test.mjs tests/confirmation.test.mjs tests/security.test.mjs tests/audit.test.mjs tests/reliability.test.mjs && node --experimental-strip-types --test tests/scheduling.test.mjs tests/pressure-test.test.mjs tests/adversarial.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "delete-user": "node scripts/delete-user.mjs",
    "seed-demo": "node scripts/seed-demo-families.mjs",
    "delete-seed": "node scripts/delete-seed.mjs",
    "link:test": "supabase link --project-ref jfyjgmhqnlbdcafoarrg",
    "link:prod": "supabase link --project-ref ujcrnrcgbvzyqosykkjy",
    "dev:staging": "vite --mode staging",
    "test": "npm run test:foundation && npm run test:sites",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@supabase/supabase-js": "^2.111.0",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
