# Browser-safe Supabase configuration. The publishable key is intentionally
# exposed to the app; database authorization is enforced with row-level security.
#
# .env.local          → production (used by Vercel builds)
# .env.staging.local  → staging (used by `npm run dev:staging` for tests)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# VAPID public key for PWA push notifications (browser-safe).
# Generate with: npx web-push generate-vapid-keys
# Or: node -e "const c=require('crypto');const {publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'P-256'});const pub=publicKey.export({type:'spki',format:'der'}).slice(-65).toString('base64url');const priv=privateKey.export({type:'pkcs8',format:'der'}).slice(-32).toString('base64url');console.log('Public:',pub);console.log('Private:',priv)"
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Never put a Supabase secret key or service-role key in a VITE_* variable.
# The VAPID private key is set as a Supabase Edge Function secret, not here.
